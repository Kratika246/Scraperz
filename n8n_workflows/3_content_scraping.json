{
  "name": "3. Content Scraping",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "content-scrape",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-content-scrape",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "content-scrape-webhook-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brightdata.com/dca/trigger",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 3691c1f4-35a8-4b61-82ed-fe3177c56150"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"collector\": \"c_fake_collector_id_posts\",\n  \"profiles\": \"{{ $('Webhook').item.json.body.handles }}\"\n}",
        "options": {}
      },
      "id": "bd-scraper",
      "name": "Bright Data Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/content/callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "super_secret_hackathon_key_123"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"competitor_id\": \"{{ $('Webhook').item.json.body.competitor_id }}\",\n  \"tenant_id\": \"{{ $('Webhook').item.json.body.tenant_id }}\",\n  \"content\": [\n    {\n      \"platform\": \"linkedin\",\n      \"content_type\": \"post\",\n      \"text\": \"Exciting new product update...\",\n      \"media_urls\": [\"https://example.com/image.jpg\"],\n      \"posted_at\": \"2023-10-27T10:00:00Z\",\n      \"engagement_metrics\": { \"likes\": 150, \"comments\": 12 }\n    }\n  ]\n}",
        "options": {}
      },
      "id": "callback",
      "name": "Callback to Next.js",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Bright Data Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bright Data Scraper": {
      "main": [
        [
          {
            "node": "Callback to Next.js",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
