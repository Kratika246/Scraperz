{
  "name": "Weekly API refresh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "schedule-weekly",
      "name": "Every Monday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 240]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "weekly-refresh",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-weekly",
      "name": "Manual webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [220, 420],
      "webhookId": "weekly-refresh-webhook-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.NEXTJS_APP_URL}}/api/jobs/weekly",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Secret", "value": "={{$env.N8N_WEBHOOK_SECRET}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "call-weekly-api",
      "name": "POST /api/jobs/weekly",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 320]
    }
  ],
  "connections": {
    "Every Monday 09:00": {
      "main": [[{ "node": "POST /api/jobs/weekly", "type": "main", "index": 0 }]]
    },
    "Manual webhook": {
      "main": [[{ "node": "POST /api/jobs/weekly", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
