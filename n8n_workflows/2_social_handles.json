{
  "name": "2. Social Handles",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "social-handles",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-social-handles",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "social-handles-webhook-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brightdata.com/dca/trigger",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 3691c1f4-35a8-4b61-82ed-fe3177c56150"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"collector\": \"c_fake_collector_id_socials\",\n  \"url\": \"{{$json.body.website_url}}\"\n}",
        "options": {}
      },
      "id": "bd-scraper",
      "name": "Bright Data Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/social-handles/callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "super_secret_hackathon_key_123"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"competitor_id\": \"{{ $('Webhook').item.json.body.competitor_id }}\",\n  \"tenant_id\": \"{{ $('Webhook').item.json.body.tenant_id }}\",\n  \"handles\": [\n    {\n      \"platform\": \"linkedin\",\n      \"handle\": \"acme-corp\",\n      \"profile_url\": \"https://linkedin.com/company/acme-corp\",\n      \"verified\": true,\n      \"verification_confidence\": 0.99\n    }\n  ]\n}",
        "options": {}
      },
      "id": "callback",
      "name": "Callback to Next.js",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Bright Data Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bright Data Scraper": {
      "main": [
        [
          {
            "node": "Callback to Next.js",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
