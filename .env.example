# Bright Data Scraper Studio — API token + collector IDs (c_...)
BRIGHTDATA_API_KEY=
# Optional: set to "dev" to hit the development version of a collector
# BRIGHTDATA_COLLECTOR_VERSION=dev

# One collector per scrape job. Input schema must match lib/brightdata.ts
BRIGHTDATA_COLLECTOR_BRAND_WEBSITE=          # input: { url }
BRIGHTDATA_COLLECTOR_COMPETITORS=            # input: { keyword, industry, brand_name }
BRIGHTDATA_COLLECTOR_SOCIAL_HANDLES=         # input: { url }
BRIGHTDATA_COLLECTOR_SOCIAL_CONTENT=         # input: { url, platform }
# Optional per-network overrides (fall back to SOCIAL_CONTENT if empty)
BRIGHTDATA_COLLECTOR_LINKEDIN_POSTS=
BRIGHTDATA_COLLECTOR_X_POSTS=